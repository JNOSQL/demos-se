<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <artifactId>qdrant-vector</artifactId>
    <name>JNoSQL Demo using Java SE Qdrant Vector</name>

    <parent>
        <groupId>org.eclipse.jnosql.mapping</groupId>
        <artifactId>mapping-demo-java-se</artifactId>
        <version>1.1.20</version>
    </parent>

    <properties>
        <jnosql.version>1.1.21-SNAPSHOT</jnosql.version>
        <langchain4j.embeddings.version>1.22.0-beta32</langchain4j.embeddings.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.eclipse.jnosql.databases</groupId>
            <artifactId>jnosql-qdrant</artifactId>
            <version>${jnosql.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jnosql.mapping</groupId>
            <artifactId>jnosql-mapping-vector</artifactId>
            <version>${jnosql.version}</version>
        </dependency>
        <!-- Used only to generate embeddings locally (in-process ONNX, no API key) -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-embeddings-all-minilm-l6-v2-q</artifactId>
            <version>${langchain4j.embeddings.version}</version>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>central-portal-snapshots</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>
</project>
